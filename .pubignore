# .pubignore replaces .gitignore for publishing — keep its entries duplicated.
.dart_tool/
doc/api/
pubspec.lock
*.exe

# Internal working documents, not part of the published package.
AGENTS.md
CLAUDE.md
docs/

# The Russian translation of the README is the owner's working copy: it lives
# in the repository only, and README.md deliberately does not link to it.
README.ru.md

# The test suite is of no use to a consumer and is half the uncompressed
# archive.
test/

# Do NOT add analysis_options.yaml here: example/logger_builder_examples
# includes it through a relative path. Measured on an unpacked archive
# without it, because the wording here used to guess: the example does not
# stop analysing. It analyses by the wrong rules — one unresolved-include
# info, and the whole lint set silently gone. Which is worse than stopping,
# and the reason this line stays.

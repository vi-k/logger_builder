# .pubignore replaces .gitignore for publishing — keep its entries duplicated.
.dart_tool/
doc/api/
pubspec.lock
*.exe

# Internal working documents, not part of the published package.
AGENTS.md
CLAUDE.md
docs/

# The Russian translation of the README lives in the repository only: pub.dev
# renders a single README, and shipping a second one would only bloat the
# archive. README.md links to it by absolute URL, which works from pub.dev too.
README.ru.md

# The test suite is of no use to a consumer and is half the uncompressed
# archive.
test/

# Do NOT add analysis_options.yaml here: example/logger_builder_examples
# includes it through a relative path, and the published example would stop
# analysing without it.
